# Contract Review System - optional LLM config
#
# Two ways to configure:
#   1) Copy this file to ".env" and fill in LLM_API_KEY below, then restart.
#   2) Or use the web UI: top-right "大模型设置" button (can also persist to .env).
#
# Real process environment variables always take precedence over this file.

# Required to enable LLM features. Leave EMPTY to run with the rule engine only.
LLM_API_KEY=

# OpenAI-compatible chat completions endpoint. Examples:
#   OpenAI        https://api.openai.com/v1/chat/completions
#   DeepSeek      https://api.deepseek.com/v1/chat/completions
#   Aliyun Bailian https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# Model name, e.g. gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL=gpt-4o-mini

# Optional HTTP(S) proxy, e.g. http://127.0.0.1:7890 (needed for OpenAI in CN)
LLM_PROXY=

# Request timeout (seconds)
LLM_TIMEOUT=30

# 1 = LLM generates a clause suggestion for every risk (real-time)
# 0 = use the preset suggestion text from the rule library (deterministic)
LLM_SUGGEST=1


# ---------------------------------------------------------------------------
# Failure alert mail (optional): send a notification when a contract fails to
# parse / upload. Configured via the web UI page "失败上传到QQ邮箱" as well.
# Leave SMTP_USER empty to disable; the review pipeline is NOT affected.
# ---------------------------------------------------------------------------

# SMTP server. QQ Mail uses smtp.qq.com with SSL port 465.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# Sender mailbox, e.g. 123456@qq.com
SMTP_USER=

# QQ Mail **SMTP authorization code** (NOT your QQ login password).
# Path: QQ Mail -> Settings -> Account -> enable IMAP/SMTP -> generate code.
SMTP_PASS=

# Recipient. Leave empty to send to SMTP_USER itself.
MAIL_TO=

# 1 = send when a task gets blocked; 0 = never send automatically.
MAIL_ENABLED=1


# ---------------------------------------------------------------------------
# Access gate (production only): when set, ALL /api requests require the
# header "X-API-Key: <value>". The login page will ask users for this code.
# Leave EMPTY to stay in open demo mode (no auth).
API_AUTH_KEY=


# ---------------------------------------------------------------------------
# A1/A2：JWT 令牌签名密钥（必填，缺失即拒绝启动）
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   部署时务必更换为随机值，禁止沿用任何示例值。
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# 演示身份登录（可选，默认 1=开启）
#   1：登录页显示「登录身份」下拉，选定角色即可进入（服务端仍按角色矩阵校验）。
#      每个请求带 X-Role 头，不依赖 JWT 密钥稳定性，适合演示 / 评审场景。
#   0：关闭，只保留账号密码（JWT）通道 —— 生产环境的硬鉴权姿势。
# ---------------------------------------------------------------------------
DEMO_ROLE_LOGIN=1

# ---------------------------------------------------------------------------
# 配置加密主密钥（可选）
#   留空则自动生成并保存到 data/.secrets.key（已被 .gitignore 排除）。
#   多实例部署需要共享同一密钥时，在这里显式指定同一个值。
#   SMTP 授权码 / 发件邮箱 / 收件邮箱等敏感项均以此密钥 scrypt 派生后加密落盘。
# ---------------------------------------------------------------------------
APP_SECRET_KEY=

# A1：管理员账号（规则编辑 / 合同编辑等管理权限）。密码由部署环境注入，
# 不写入 users.json；留空则系统无管理员账号，仅注册用户可登录（只读）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

