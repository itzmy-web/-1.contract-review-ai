@echo off
REM ===========================================================================
REM  ONE-TIME setup for a FIXED Cloudflare Tunnel (needs a domain on Cloudflare)
REM  Prerequisites (do these first):
REM    1) Buy a cheap domain (e.g. xxx.top / xxx.xyz, ~RMB 10-30/yr).
REM    2) Create a FREE Cloudflare account, add the domain, and change the
REM       domain's nameservers at your registrar to the two Cloudflare NS.
REM    3) Wait for DNS to propagate (minutes to a few hours).
REM  Run this bat with system proxy ON (do NOT clear proxy) - the login and
REM  API calls need outbound access. The browser login step is interactive.
REM ===========================================================================
setlocal
set CF=C:\Users\zmy\cloudflared\cloudflared.exe

echo Step 1/3: cloudflared login  (browser opens - authorize your domain)
"%CF%" tunnel login
if errorlevel 1 ( echo [X] login failed & goto :eof )

echo Step 2/3: create named tunnel "contract"
"%CF%" tunnel create contract
if errorlevel 1 ( echo [X] create failed & goto :eof )

set /p DOMAIN=Enter your domain (e.g. xxx.top): 
echo Step 3/3: route DNS  contract.%DOMAIN% -^> tunnel
"%CF%" tunnel route dns contract contract.%DOMAIN%
if errorlevel 1 ( echo [X] route dns failed & goto :eof )

echo Writing C:\Users\zmy\.cloudflared\config.yml ...
(
echo # Cloudflare named tunnel - generated by setup_cloudflare_tunnel.bat
echo ingress:
echo   - hostname: contract.%DOMAIN%
echo     service: http://localhost:8010
echo   - service: http_status:404
) > "C:\Users\zmy\.cloudflared\config.yml"

echo.
echo [OK] Setup complete. Your FIXED public URL will be:
echo      https://contract.%DOMAIN%
echo Now double-click start_cloudflare_named.bat to launch it.
endlocal
